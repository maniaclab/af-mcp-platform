---
/**
 * PublicBase.astro — the shell for pages that must render without a
 * Keycloak session, unlike every page under Base.astro. Base.astro's inline
 * mount script unconditionally checks for a valid OIDC session and
 * redirects to Keycloak if there isn't one (see its own docstring) --
 * reusing it here would mean an unauthenticated visitor to the public
 * landing page gets bounced straight into a login flow, exactly what this
 * layout exists to avoid. Deliberately minimal: no sidebar, no user
 * controls, no identity-fetching script -- just a top bar with the brand and
 * theme toggle, the shared fonts/tokens, and the footer, reused from
 * Base.astro's own components.
 */
import '../styles/global.css';
import Fonts from '../components/Fonts.astro';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { THEME_INIT_SCRIPT } from '../lib/themeInitScript.js';

interface Props {
  title?: string;
}

const { title = 'AF MCP Platform' } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <!-- Must run before any stylesheet -- see Base.astro's matching comment
         and global.css's "Theming" docstring for why. -->
    <script is:inline set:html={THEME_INIT_SCRIPT} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — AF MCP Platform</title>

    <Fonts />

    <style>
      .pb-shell {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      .pb-main {
        flex: 1;
      }
    </style>
  </head>
  <body class="h-full">
    <a href="#main-content" class="skip-link">Skip to content</a>

    <div class="pb-shell">
      <header class="af-topbar">
        <div class="af-wrap af-topbar__in">
          <a href="/" class="af-brand" data-af-brand="shortName">AF&nbsp;/&nbsp;MCP</a>
          <div class="af-topbar__spacer" aria-hidden="true"></div>
          <ThemeToggle />
        </div>
      </header>

      <main id="main-content" class="pb-main">
        <slot />
      </main>

      <Footer />
    </div>
  </body>
</html>
