---
/**
 * PublicBase.astro — the shell for pages that must render without a
 * Keycloak session, unlike every page under Base.astro. Base.astro's inline
 * mount script unconditionally checks for a valid OIDC session and
 * redirects to Keycloak if there isn't one (see its own docstring) --
 * reusing it here would mean an unauthenticated visitor to the public
 * landing page gets bounced straight into a login flow, exactly what this
 * layout exists to avoid. Deliberately minimal: no sidebar, no topbar user
 * controls, no identity-fetching script -- just the shared fonts/tokens and
 * footer, reused from Base.astro's own components.
 */
import '../styles/global.css';
import Fonts from '../components/Fonts.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
}

const { title = 'AF MCP Platform' } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — AF MCP Platform</title>

    <Fonts />

    <style>
      * {
        box-sizing: border-box;
      }

      html,
      body {
        background: var(--color-af-void);
        color: var(--color-af-text);
        font-family: 'IBM Plex Sans', system-ui, sans-serif;
        font-size: 15px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        min-height: 100%;
      }

      .skip-link {
        position: absolute;
        top: -100%;
        left: 1rem;
        background: var(--color-af-teal);
        color: var(--color-af-void);
        padding: 0.5rem 1rem;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        z-index: 1000;
      }
      .skip-link:focus {
        top: 1rem;
      }

      .pb-shell {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      .pb-main {
        flex: 1;
      }
    </style>
  </head>
  <body class="h-full">
    <a href="#main-content" class="skip-link">Skip to content</a>

    <div class="pb-shell">
      <main id="main-content" class="pb-main">
        <slot />
      </main>

      <Footer />
    </div>
  </body>
</html>
