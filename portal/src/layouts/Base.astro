---
/**
 * Base.astro — shell layout for every portal page.
 *
 * This is a static build. Identity is NOT read from request headers at render
 * time (those are empty in a static output and embedding a token would be an
 * XSS-exfiltration risk). Instead, on mount the inline script below checks
 * for a valid OIDC session (see ../lib/auth) — initiating the Authorization
 * Code + PKCE redirect if there isn't one — and once authenticated fills the
 * topbar username (and any element tagged `data-af-identity`) from
 * GET /v1/identities, sent with the session's Bearer token (see ../lib/api).
 *
 * Shell structure (#166): fixed left sidebar with grouped nav + count badges,
 * slim topbar with the user controls, content column with footer. On narrow
 * viewports the sidebar becomes an off-canvas drawer toggled from the topbar.
 */
import '../styles/global.css';
import Fonts from '../components/Fonts.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
}

const { title = 'AF MCP Platform' } = Astro.props;

// Sidebar nav, grouped Filament-style. Badge slots are keyed by href and
// filled on mount from the dashboard summary (see ../lib/navSummary).
const navGroups: {
  label: string | null;
  items: { href: string; label: string; icon: string; badge: boolean }[];
}[] = [
  {
    label: null,
    items: [{ href: '/overview/', label: 'Overview', icon: 'home', badge: false }],
  },
  {
    label: 'Access',
    items: [
      { href: '/catalog/', label: 'Services', icon: 'servers', badge: true },
      { href: '/identities/', label: 'Identities', icon: 'identity', badge: true },
    ],
  },
  {
    label: 'Credentials',
    items: [{ href: '/tokens/', label: 'Tokens', icon: 'key', badge: true }],
  },
];

// Decorative stroke icons (aria-hidden), one or more path `d` strings each,
// drawn on a 24×24 grid. Inlined so the strict CSP needs no image hosts.
const icons: Record<string, string[]> = {
  home: ['M3 10.5 12 3l9 7.5', 'M5.5 8.5V21h13V8.5'],
  servers: ['M4 4.5h16v6.5H4z', 'M4 13h16v6.5H4z', 'M7.5 7.75h.01', 'M7.5 16.25h.01'],
  identity: ['M12 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z', 'M4.5 20.5a7.5 7.5 0 0 1 15 0'],
  key: [
    'M8 15.5m-3.5 0a3.5 3.5 0 1 0 7 0 3.5 3.5 0 1 0-7 0',
    'M10.8 13 19.5 4.3',
    'M16.2 7.6l2.2 2.2',
  ],
  shield: ['M12 3l7 3v5.2c0 4.3-2.9 8.2-7 9.8-4.1-1.6-7-5.5-7-9.8V6l7-3z'],
};

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — AF MCP Platform</title>

    <Fonts />

    <style>
      /* -----------------------------------------------------------------------
       All colour tokens live in src/styles/global.css inside the Tailwind
       `@theme` block. Reference them here as var(--color-af-*).
    ----------------------------------------------------------------------- */
      * {
        box-sizing: border-box;
      }

      html,
      body {
        background: var(--color-af-void);
        color: var(--color-af-text);
        font-family: 'IBM Plex Sans', system-ui, sans-serif;
        font-size: 15px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        min-height: 100%;
      }

      /* Skip link for keyboard accessibility */
      .skip-link {
        position: absolute;
        top: -100%;
        left: 1rem;
        background: var(--color-af-teal);
        color: var(--color-af-void);
        padding: 0.5rem 1rem;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        z-index: 1000;
      }
      .skip-link:focus {
        top: 1rem;
      }

      /* Shell ------------------------------------------------------------------
       Sidebar + content column. The sidebar is sticky full-height on desktop
       and an off-canvas drawer below 900px.
    ----------------------------------------------------------------------- */
      .af-shell {
        display: flex;
        min-height: 100vh;
      }

      /* Sidebar ---------------------------------------------------------------- */
      .af-sidebar {
        width: 236px;
        flex-shrink: 0;
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        padding: 0 0.75rem 1.25rem;
        background: rgb(from var(--color-af-surface) r g b / 0.45);
        border-right: 1px solid var(--color-af-border);
      }

      .af-sidebar__logo {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        height: 56px;
        padding: 0 0.75rem;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.875rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: var(--color-af-teal);
        text-decoration: none;
        white-space: nowrap;
        text-transform: uppercase;
      }

      .af-sidebar__group {
        margin-top: 1rem;
      }

      .af-sidebar__group-label {
        /* --text-label from the @theme type scale (0.6875rem / 600 / 0.1em) --
           af-dim rather than af-label: this is a nav wayfinding cue read at a
           glance, so it gets the stronger of the two secondary-text tokens. */
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-af-dim);
        padding: 0 0.75rem;
        margin: 0 0 0.375rem;
      }

      .af-sidebar__list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .af-sidebar__link {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.4375rem 0.75rem;
        border-radius: 4px;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        color: var(--color-af-dim);
        transition:
          color 150ms,
          background-color 150ms;
      }

      .af-sidebar__link:hover,
      .af-sidebar__link:focus-visible {
        color: var(--color-af-text);
        background: rgb(from var(--color-af-muted) r g b / 0.3);
        outline: none;
      }

      .af-sidebar__link[aria-current='page'] {
        color: var(--color-af-teal);
        background: rgb(from var(--color-af-teal) r g b / 0.08);
      }

      .af-sidebar__icon {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
        opacity: 0.85;
      }

      .af-sidebar__label {
        flex: 1;
        min-width: 0;
      }

      .af-sidebar__badge {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.625rem;
        font-weight: 600;
        line-height: 1.4;
        padding: 0.0625rem 0.4375rem;
        border-radius: 999px;
      }
      .af-sidebar__badge--ok {
        color: var(--color-af-teal);
        background: rgb(from var(--color-af-teal) r g b / 0.12);
      }
      .af-sidebar__badge--neutral {
        color: var(--color-af-dim);
        background: rgb(from var(--color-af-muted) r g b / 0.35);
      }

      .af-sidebar-overlay {
        display: none;
      }

      /* Content column --------------------------------------------------------- */
      .af-content {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
      }

      /* Topbar ------------------------------------------------------------------ */
      .af-topbar {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgb(from var(--color-af-void) r g b / 0.92);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--color-af-border);
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0 2rem;
        height: 56px;
      }

      .af-topbar__menu {
        display: none;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: transparent;
        border: 1px solid var(--color-af-border);
        border-radius: 4px;
        color: var(--color-af-dim);
        cursor: pointer;
        transition:
          color 150ms,
          border-color 150ms;
      }
      .af-topbar__menu:hover,
      .af-topbar__menu:focus-visible {
        color: var(--color-af-text);
        border-color: var(--color-af-muted);
        outline: none;
      }
      .af-topbar__menu svg {
        width: 18px;
        height: 18px;
      }

      .af-topbar__logo {
        display: none;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: var(--color-af-teal);
        text-decoration: none;
        white-space: nowrap;
        text-transform: uppercase;
      }

      .af-topbar__spacer {
        flex: 1;
      }

      .af-topbar__user-group {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .af-topbar__user {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.6875rem;
        color: var(--color-af-dim);
        letter-spacing: 0.04em;
      }

      .af-topbar__signout {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.6875rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--color-af-dim);
        background: transparent;
        border: 1px solid var(--color-af-border);
        border-radius: 2px;
        padding: 0.25rem 0.625rem;
        cursor: pointer;
        transition:
          color 150ms,
          border-color 150ms;
      }
      .af-topbar__signout:hover,
      .af-topbar__signout:focus-visible {
        color: var(--color-af-red);
        border-color: rgb(from var(--color-af-red) r g b / 0.4);
        outline: none;
      }

      /* Main content --------------------------------------------------------- */
      .af-main {
        flex: 1;
        padding: 2.5rem 2rem;
        max-width: 1200px;
        margin: 0 auto;
        width: 100%;
      }

      /* Responsive ----------------------------------------------------------- */
      @media (max-width: 900px) {
        .af-sidebar {
          position: fixed;
          left: 0;
          top: 0;
          z-index: 100;
          width: 248px;
          background: var(--color-af-surface);
          transform: translateX(-100%);
          transition: transform 200ms ease;
        }
        .af-sidebar.is-open {
          transform: translateX(0);
          box-shadow: 4px 0 24px rgb(0 0 0 / 0.4);
        }

        .af-sidebar-overlay {
          display: block;
          position: fixed;
          inset: 0;
          z-index: 90;
          background: rgb(0 0 0 / 0.5);
        }
        .af-sidebar-overlay[hidden] {
          display: none;
        }

        .af-topbar {
          padding: 0 1rem;
        }
        .af-topbar__menu {
          display: flex;
        }
        .af-topbar__logo {
          display: block;
        }

        .af-main {
          padding: 1.5rem 1rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .af-sidebar {
          transition: none;
        }
      }

      @media (max-width: 640px) {
        .af-topbar__user-group {
          display: none;
        }
      }
    </style>

    <!--
    is:inline keeps this literally inline in the HTML instead of Astro
    bundling it into the external, hashed stylesheet (which is where the two
    <style> blocks above end up — check dist/*.html after a build if that's
    surprising). The auth-init script below can remove #af-auth-splash before
    that external stylesheet's <link> has even started fetching, so this
    block's rules need to be present the instant the element is parsed.
  -->
    <style is:inline>
      .af-auth-splash {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--color-af-void);
      }

      .af-auth-splash__inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
      }

      .af-auth-splash__spinner {
        width: 28px;
        height: 28px;
        border: 3px solid var(--color-af-border);
        border-top-color: var(--color-af-teal);
        border-radius: 50%;
        animation: af-auth-splash-spin 600ms linear infinite;
      }

      .af-auth-splash__inner p {
        margin: 0;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.8125rem;
        color: var(--color-af-dim);
        letter-spacing: 0.04em;
      }

      @keyframes af-auth-splash-spin {
        to {
          transform: rotate(360deg);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .af-auth-splash__spinner {
          animation: none;
          border-top-color: var(--color-af-dim);
        }
      }
    </style>
  </head>
  <body class="h-full">
    {
      // /callback runs its own OIDC exchange (see pages/callback.astro) and
      // has its own "Completing sign-in…" status UI — don't double it up.
      currentPath !== '/callback' && (
        <div id="af-auth-splash" class="af-auth-splash" role="status" aria-live="polite">
          <div class="af-auth-splash__inner">
            <div class="af-auth-splash__spinner" aria-hidden="true" />
            <p>Signing in…</p>
          </div>
        </div>
      )
    }

    <a href="#main-content" class="skip-link">Skip to content</a>

    <div class="af-shell">
      <aside class="af-sidebar" id="af-sidebar">
        <a href="/overview/" class="af-sidebar__logo" aria-label="AF MCP Platform home">
          AF&nbsp;/&nbsp;MCP
        </a>

        <nav aria-label="Primary navigation">
          {
            navGroups.map((group) => (
              <div class="af-sidebar__group">
                {group.label && <p class="af-sidebar__group-label">{group.label}</p>}
                <ul class="af-sidebar__list" role="list">
                  {group.items.map(({ href, label, icon, badge }) => {
                    const isActive = currentPath.startsWith(href.replace(/\/$/, ''));
                    return (
                      <li>
                        <a
                          href={href}
                          class="af-sidebar__link"
                          aria-current={isActive ? 'page' : undefined}
                        >
                          <svg
                            class="af-sidebar__icon"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            {icons[icon].map((d) => (
                              <path d={d} />
                            ))}
                          </svg>
                          <span class="af-sidebar__label">{label}</span>
                          {badge && (
                            <span class="af-sidebar__badge" data-af-nav-badge={href} hidden />
                          )}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </nav>
      </aside>

      <div class="af-sidebar-overlay" data-af-sidebar-overlay role="presentation" hidden></div>

      <div class="af-content">
        <header class="af-topbar">
          <button
            type="button"
            class="af-topbar__menu"
            data-af-sidebar-toggle
            aria-controls="af-sidebar"
            aria-expanded="false"
            aria-label="Toggle navigation"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M4 6.5h16M4 12h16M4 17.5h16"></path>
            </svg>
          </button>

          <a href="/overview/" class="af-topbar__logo" aria-label="AF MCP Platform home">
            AF&nbsp;/&nbsp;MCP
          </a>

          <div class="af-topbar__spacer" aria-hidden="true"></div>

          <div class="af-topbar__user-group" data-af-user-holder hidden>
            <span class="af-topbar__user" data-af-identity aria-label="Signed in"></span>
            <button type="button" class="af-topbar__signout" data-af-signout hidden>Sign out</button
            >
          </div>
        </header>

        <main id="main-content" class="af-main">
          <slot />
        </main>

        <Footer />
      </div>
    </div>

    <!--
    On mount: ensure an OIDC session exists (redirecting to Keycloak if not),
    then populate every [data-af-identity] element (topbar username, hero
    greeting) from the broker, and pin the nav badges from the dashboard
    summary. This is the only identity source in a static build.
  -->
    <script>
      import {
        clearIdentitiesCache,
        fetchDashboardSummary,
        fetchIdentities,
        revokeAllCredentials,
      } from '../lib/api';
      import { getUser, isOidcConfigured, login, logout } from '../lib/auth';
      import { navBadges } from '../lib/navSummary';

      // Off-canvas sidebar toggle — registered before the auth check so the
      // drawer works even when the page renders unauthenticated (dev bypass).
      (() => {
        const sidebar = document.getElementById('af-sidebar');
        const toggle = document.querySelector<HTMLButtonElement>('[data-af-sidebar-toggle]');
        const overlay = document.querySelector<HTMLElement>('[data-af-sidebar-overlay]');
        if (!sidebar || !toggle || !overlay) return;

        const setOpen = (open: boolean) => {
          sidebar.classList.toggle('is-open', open);
          overlay.hidden = !open;
          toggle.setAttribute('aria-expanded', String(open));
        };

        toggle.addEventListener('click', () => {
          setOpen(!sidebar.classList.contains('is-open'));
        });
        overlay.addEventListener('click', () => setOpen(false));
        document.addEventListener('keydown', (ev) => {
          if (ev.key === 'Escape' && sidebar.classList.contains('is-open')) {
            setOpen(false);
            toggle.focus();
          }
        });
      })();

      (async () => {
        const splash = document.getElementById('af-auth-splash');

        try {
          const user = await getUser();
          if (!user) {
            // Don't redirect while /callback's own exchange is in flight —
            // that page runs the OIDC handshake itself and lands the user back
            // wherever they started once it completes (see pages/callback.astro).
            const path = window.location.pathname.replace(/\/$/, '') || '/';
            if (path !== '/callback') {
              if (await isOidcConfigured()) {
                // Leave the splash up — login() replaces this page with
                // Keycloak's redirect, so the last thing visible is the
                // splash rather than a flash of portal chrome.
                await login();
              } else {
                // Dev-bypass mode: no Keycloak in the loop to redirect to —
                // render the page unauthenticated.
                splash?.remove();
              }
            }
            return;
          }

          splash?.remove();
        } catch (err) {
          // getUser()/isOidcConfigured() already swallow config-load and
          // token errors internally (see ../lib/auth), but guard against
          // anything else throwing — render unauthenticated rather than
          // trap the user behind a permanent splash.
          console.warn(
            '[auth] session check failed unexpectedly — rendering unauthenticated.',
            err,
          );
          splash?.remove();
          return;
        }

        try {
          const id = await fetchIdentities();
          const label = id.email || id.unixname;
          if (!label) return;
          document.querySelectorAll<HTMLElement>('[data-af-identity]').forEach((el) => {
            el.textContent = label;
            const holder = el.closest<HTMLElement>('[data-af-user-holder]');
            if (holder) holder.hidden = false;
            else el.hidden = false;
          });

          // Sign-out control is topbar-only and OIDC-only — dev-bypass mode
          // has no Keycloak session to end, so it stays hidden there.
          if (await isOidcConfigured()) {
            const signOutBtn = document.querySelector<HTMLButtonElement>('[data-af-signout]');
            if (signOutBtn) {
              signOutBtn.hidden = false;
              signOutBtn.addEventListener('click', async () => {
                try {
                  await revokeAllCredentials();
                } catch {
                  // Best-effort purge — a failed revoke must not block sign-out.
                }
                clearIdentitiesCache();
                await logout();
              });
            }
          }
        } catch {
          // Session expired mid-page (broker 401'd after silent renew also
          // failed) — leave the identity slot hidden rather than looping.
        }

        // Sidebar badges are decorative — fill them best-effort and never
        // let a summary failure disturb the page (navBadges(null) → none).
        try {
          const summary = await fetchDashboardSummary();
          for (const badge of navBadges(summary)) {
            const el = document.querySelector<HTMLElement>(`[data-af-nav-badge="${badge.href}"]`);
            if (!el) continue;
            el.textContent = badge.text;
            el.classList.add(`af-sidebar__badge--${badge.tone}`);
            el.hidden = false;
          }
        } catch {
          // Badges stay hidden — the nav degrades to plain labels.
        }
      })();
    </script>
  </body>
</html>
