---
/**
 * Base.astro — shell layout for every portal page.
 *
 * This is a static build. Identity is NOT read from request headers at render
 * time (those are empty in a static output and embedding a token would be an
 * XSS-exfiltration risk). Instead, on mount the inline script below checks
 * for a valid OIDC session (see ../lib/auth) — initiating the Authorization
 * Code + PKCE redirect if there isn't one — and once authenticated fills the
 * sidebar username (and any element tagged `data-af-identity`) from
 * GET /v1/identities, sent with the session's Bearer token (see ../lib/api).
 *
 * Shell structure (#166): fixed left sidebar with grouped nav + count badges
 * and the theme toggle beside the brand at its top, the account controls at
 * its foot; content column with footer. Under 860px the sidebar becomes an
 * off-canvas drawer toggled from a top bar.
 */
import '../styles/global.css';
import {
  ChartColumn,
  House,
  KeyRound,
  List,
  LogOut,
  Menu,
  Server,
  Shield,
  UserRound,
} from '@lucide/astro';
import Fonts from '../components/Fonts.astro';
import Footer from '../components/Footer.astro';
import MaintenanceBanner from '../components/MaintenanceBanner.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { THEME_INIT_SCRIPT } from '../lib/themeInitScript.js';

interface Props {
  title?: string;
}

const { title = 'AF MCP Platform' } = Astro.props;

// Sidebar nav, grouped Filament-style. Badge slots are keyed by href and
// filled on mount from the dashboard summary (see ../lib/navSummary).
// adminOnly items render `hidden` and are only revealed on mount once
// GET /v1/identities reports `is_admin: true` (see the mount script below) —
// this is a static build with no per-request server auth state, so hiding
// happens client-side rather than by omitting the markup at render time.
const navGroups: {
  label: string | null;
  items: { href: string; label: string; icon: string; badge: boolean; adminOnly: boolean }[];
}[] = [
  {
    label: null,
    items: [
      { href: '/overview/', label: 'Overview', icon: 'home', badge: false, adminOnly: false },
    ],
  },
  {
    label: 'Access',
    items: [
      { href: '/catalog/', label: 'Services', icon: 'servers', badge: true, adminOnly: false },
      {
        href: '/identities/',
        label: 'Identities',
        icon: 'identity',
        badge: true,
        adminOnly: false,
      },
    ],
  },
  {
    label: 'Credentials',
    items: [{ href: '/tokens/', label: 'Tokens', icon: 'key', badge: true, adminOnly: false }],
  },
  {
    label: 'Activity',
    items: [{ href: '/usage/', label: 'Usage', icon: 'chart', badge: false, adminOnly: false }],
  },
  {
    label: 'Platform',
    items: [
      {
        href: '/entitlements/',
        label: 'Entitlements',
        icon: 'list',
        badge: false,
        adminOnly: false,
      },
      { href: '/admin/', label: 'Admin', icon: 'shield', badge: false, adminOnly: true },
    ],
  },
];

// Decorative Lucide icons (rendered aria-hidden), keyed by navGroups' `icon`.
const icons: Record<string, typeof House> = {
  home: House,
  servers: Server,
  identity: UserRound,
  key: KeyRound,
  shield: Shield,
  chart: ChartColumn,
  list: List,
};

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en" class="scrollbar h-full">
  <head>
    <meta charset="UTF-8" />
    <!--
      Must run before any stylesheet -- global.css's LIGHT default and
      Basecoat's own dark: utilities both key off .dark on this exact
      element (see global.css's "Theming" docstring), so it has to be
      applied before CSS is evaluated for layout, not after. is:inline (like
      the auth-splash <style> further down) keeps this a literal, unbundled,
      render-blocking script instead of the deferred module Astro would
      normally turn a <script> into -- see astro.config.mjs for how its hash
      reaches the CSP without regex-scanning this file.
    -->
    <script is:inline set:html={THEME_INIT_SCRIPT} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — AF MCP Platform</title>

    <Fonts />

    <style>
      /* Colour, type, space and motion tokens live in src/styles/global.css;
         shared shell classes (.af-wrap, .af-topbar, .af-brand, .af-nav,
         .skip-link) live in src/styles/components.css. */

      .af-shell {
        display: flex;
        min-height: 100vh;
      }

      /* Sidebar ---------------------------------------------------------------- */
      .af-sidebar {
        width: 220px;
        flex-shrink: 0;
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: var(--space-16);
        padding: var(--space-16) var(--space-12);
        background: var(--color-af-bg);
        border-right: 1px solid var(--color-af-border);
      }

      /* The brand sits left and the theme toggle right on one row. */
      .af-sidebar__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-8);
      }

      .af-sidebar .af-brand {
        display: block;
        padding: var(--space-8) var(--space-12);
      }

      .af-sidebar .af-nav {
        width: 100%;
        gap: var(--space-16);
      }

      .af-sidebar__label {
        flex: 1;
        min-width: 0;
      }

      /* Count badges stay plain secondary text; the tone modifier classes the
         mount script adds carry no extra styling. */
      .af-sidebar__badge {
        font-size: var(--text-12);
        font-weight: 400;
        font-variant-numeric: tabular-nums;
        color: var(--color-af-text-secondary);
      }

      .af-sidebar__foot {
        margin-top: auto;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-8);
      }

      .af-sidebar__account {
        align-self: stretch;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-4);
        min-width: 0;
      }

      .af-sidebar__user {
        max-width: 100%;
        padding: 0 var(--space-12);
        font-size: var(--text-13);
        line-height: var(--text-13--line-height);
        color: var(--color-af-text-secondary);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .af-sidebar-overlay {
        display: none;
      }

      /* Content column --------------------------------------------------------- */
      .af-content {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
      }

      .af-app-topbar {
        display: none;
      }

      .af-main {
        flex: 1;
        padding-block: var(--space-32);
      }

      /* A hidden maintenance banner takes no space; a shown one sits above the
         page's own content. */
      .af-main > .af-banner {
        margin-bottom: var(--space-24);
      }
      .af-main > .af-banner.slim {
        margin-bottom: var(--space-16);
      }

      /* Under 860px the sidebar becomes an off-canvas drawer opened from the
         top bar. Closed, it is visibility:hidden so its links leave the tab
         order; the visibility change waits for the slide-out to finish. */
      @media (max-width: 859px) {
        .af-sidebar {
          position: fixed;
          left: 0;
          top: 0;
          z-index: 100;
          visibility: hidden;
          transform: translateX(-100%);
          transition:
            transform var(--time-base) var(--ease),
            visibility 0s linear var(--time-base);
        }
        .af-sidebar.is-open {
          visibility: visible;
          transform: translateX(0);
          box-shadow: var(--shadow-af-1);
          transition:
            transform var(--time-base) var(--ease),
            visibility 0s;
        }

        .af-sidebar-overlay {
          display: block;
          position: fixed;
          inset: 0;
          z-index: 90;
          background: var(--color-af-scrim);
        }
        .af-sidebar-overlay[hidden] {
          display: none;
        }

        .af-app-topbar {
          display: block;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .af-sidebar,
        .af-sidebar.is-open {
          transition: none;
        }
      }
    </style>

    <!--
    is:inline keeps this literally inline in the HTML instead of Astro
    bundling it into the external, hashed stylesheet (which is where the
    <style> block above ends up — check dist/*.html after a build if that's
    surprising). The auth-init script below can remove #af-auth-splash before
    that external stylesheet's <link> has even started fetching, so this
    block's rules need to be present the instant the element is parsed.
  -->
    <style is:inline>
      .af-auth-splash {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--color-af-bg);
      }

      .af-auth-splash__inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-16);
      }

      .af-auth-splash__spinner {
        width: 28px;
        height: 28px;
        border: 3px solid var(--color-af-border);
        border-top-color: var(--color-af-text);
        border-radius: 50%;
        animation: af-auth-splash-spin calc(var(--time-slow) * 2) linear infinite;
      }

      .af-auth-splash__inner p {
        margin: 0;
        font-family: var(--font-sans);
        font-size: var(--text-14);
        color: var(--color-af-text-secondary);
      }

      @keyframes af-auth-splash-spin {
        to {
          transform: rotate(360deg);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .af-auth-splash__spinner {
          animation: none;
          border-top-color: var(--color-af-text-secondary);
        }
      }
    </style>
  </head>
  <body class="h-full">
    {
      // /callback runs its own OIDC exchange (see pages/callback.astro) and
      // has its own "Completing sign-in…" status UI — don't double it up.
      currentPath !== '/callback' && (
        <div id="af-auth-splash" class="af-auth-splash" role="status" aria-live="polite">
          <div class="af-auth-splash__inner">
            <div class="af-auth-splash__spinner" aria-hidden="true" />
            <p>Signing in…</p>
          </div>
        </div>
      )
    }

    <a href="#main-content" class="skip-link">Skip to content</a>

    <div class="af-shell">
      <aside class="af-sidebar" id="af-sidebar">
        <div class="af-sidebar__head">
          <a
            href="/overview/"
            class="af-brand"
            aria-label="AF MCP Platform home"
            data-af-brand-logo
          >
            AF&nbsp;/&nbsp;MCP
          </a>
          <ThemeToggle />
        </div>

        <nav class="af-nav" aria-label="Primary navigation">
          {
            navGroups.map((group) => (
              <div class="af-nav-group">
                {group.label && <p class="af-nav-label">{group.label}</p>}
                <ul role="list">
                  {group.items.map(({ href, label, icon, badge, adminOnly }) => {
                    const isActive = currentPath.startsWith(href.replace(/\/$/, ''));
                    const Icon = icons[icon];
                    return (
                      <li hidden={adminOnly} data-af-admin-nav={adminOnly || undefined}>
                        <a href={href} aria-current={isActive ? 'page' : undefined}>
                          <Icon class="af-icon" size={16} aria-hidden="true" />
                          <span class="af-sidebar__label">{label}</span>
                          {badge && (
                            <span class="af-sidebar__badge" data-af-nav-badge={href} hidden />
                          )}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </nav>

        <div class="af-sidebar__foot">
          <div class="af-sidebar__account" data-af-user-holder hidden>
            <span class="af-sidebar__user" data-af-identity aria-label="Signed in"></span>
            <button
              type="button"
              class="btn"
              data-variant="ghost"
              data-size="sm"
              data-af-signout
              hidden
            >
              <LogOut class="af-icon" size={16} aria-hidden="true" />
              Sign out
            </button>
          </div>
        </div>
      </aside>

      <div class="af-sidebar-overlay" data-af-sidebar-overlay role="presentation" hidden></div>

      <div class="af-content">
        <header class="af-topbar af-app-topbar">
          <div class="af-wrap af-topbar__in">
            <button
              type="button"
              class="btn"
              data-variant="ghost"
              data-size="icon"
              data-af-sidebar-toggle
              aria-controls="af-sidebar"
              aria-expanded="false"
              aria-label="Toggle navigation"
            >
              <Menu class="af-icon" size={16} aria-hidden="true" />
            </button>

            <a
              href="/overview/"
              class="af-brand"
              aria-label="AF MCP Platform home"
              data-af-brand-logo
            >
              AF&nbsp;/&nbsp;MCP
            </a>
          </div>
        </header>

        <main id="main-content" class="af-main af-wrap">
          <MaintenanceBanner />
          <slot />
        </main>

        <Footer />
      </div>
    </div>

    <!--
    On mount: ensure an OIDC session exists (redirecting to Keycloak if not),
    then populate every [data-af-identity] element (sidebar username, hero
    greeting) from the broker, and pin the nav badges from the dashboard
    summary. This is the only identity source in a static build.
  -->
    <script>
      import {
        clearIdentitiesCache,
        fetchDashboardSummary,
        fetchIdentities,
        revokeAllCredentials,
      } from '../lib/api';
      import { getBranding, getUser, isOidcConfigured, login, logout } from '../lib/auth';
      import { applyBranding } from '../lib/branding';
      import { navBadges } from '../lib/navSummary';

      // Runs independently of the auth check below, same rationale as
      // MaintenanceBanner.astro's script -- branding is deployment identity, not
      // user-specific, so it applies whether or not this visitor ends up
      // authenticated. Patches every [data-af-brand] element (footer,
      // overview hero) plus the two logo links, which need an "X home"
      // aria-label rather than a bare field value so a generic
      // [data-af-brand] pass doesn't cover them.
      (async () => {
        const branding = await getBranding();
        applyBranding(branding);
        document.querySelectorAll<HTMLElement>('[data-af-brand-logo]').forEach((el) => {
          el.textContent = branding.shortName;
          el.setAttribute('aria-label', `${branding.fullName} home`);
        });
      })();

      // Off-canvas sidebar toggle (under 860px) — registered before the auth check so the
      // drawer works even when the page renders unauthenticated (dev bypass).
      (() => {
        const sidebar = document.getElementById('af-sidebar');
        const toggle = document.querySelector<HTMLButtonElement>('[data-af-sidebar-toggle]');
        const overlay = document.querySelector<HTMLElement>('[data-af-sidebar-overlay]');
        if (!sidebar || !toggle || !overlay) return;

        const setOpen = (open: boolean) => {
          sidebar.classList.toggle('is-open', open);
          overlay.hidden = !open;
          toggle.setAttribute('aria-expanded', String(open));
          // Move focus into the drawer so keyboard users land on the nav;
          // closing is handled by the caller (Escape returns focus to toggle).
          if (open) sidebar.querySelector<HTMLElement>('a[href]')?.focus();
        };

        toggle.addEventListener('click', () => {
          setOpen(!sidebar.classList.contains('is-open'));
        });
        overlay.addEventListener('click', () => setOpen(false));
        document.addEventListener('keydown', (ev) => {
          if (ev.key === 'Escape' && sidebar.classList.contains('is-open')) {
            setOpen(false);
            toggle.focus();
          }
        });
      })();

      (async () => {
        const splash = document.getElementById('af-auth-splash');

        try {
          const user = await getUser();
          if (!user) {
            // Don't redirect while /callback's own exchange is in flight —
            // that page runs the OIDC handshake itself and lands the user back
            // wherever they started once it completes (see pages/callback.astro).
            const path = window.location.pathname.replace(/\/$/, '') || '/';
            if (path !== '/callback') {
              if (await isOidcConfigured()) {
                // Leave the splash up — login() replaces this page with
                // Keycloak's redirect, so the last thing visible is the
                // splash rather than a flash of portal chrome.
                await login();
              } else {
                // Dev-bypass mode: no Keycloak in the loop to redirect to —
                // render the page unauthenticated.
                splash?.remove();
              }
            }
            return;
          }

          splash?.remove();
        } catch (err) {
          // getUser()/isOidcConfigured() already swallow config-load and
          // token errors internally (see ../lib/auth), but guard against
          // anything else throwing — render unauthenticated rather than
          // trap the user behind a permanent splash.
          console.warn(
            '[auth] session check failed unexpectedly — rendering unauthenticated.',
            err,
          );
          splash?.remove();
          return;
        }

        try {
          const id = await fetchIdentities();

          if (id.is_admin) {
            document.querySelectorAll<HTMLElement>('[data-af-admin-nav]').forEach((el) => {
              el.hidden = false;
            });
          }

          const label = id.email || id.unixname;
          if (!label) return;
          document.querySelectorAll<HTMLElement>('[data-af-identity]').forEach((el) => {
            el.textContent = label;
            const holder = el.closest<HTMLElement>('[data-af-user-holder]');
            if (holder) holder.hidden = false;
            else el.hidden = false;
          });

          // Sign-out control is OIDC-only — dev-bypass mode
          // has no Keycloak session to end, so it stays hidden there.
          if (await isOidcConfigured()) {
            const signOutBtn = document.querySelector<HTMLButtonElement>('[data-af-signout]');
            if (signOutBtn) {
              signOutBtn.hidden = false;
              signOutBtn.addEventListener('click', async () => {
                try {
                  await revokeAllCredentials();
                } catch {
                  // Best-effort purge — a failed revoke must not block sign-out.
                }
                clearIdentitiesCache();
                await logout();
              });
            }
          }
        } catch {
          // Session expired mid-page (broker 401'd after silent renew also
          // failed) — leave the identity slot hidden rather than looping.
        }

        // Sidebar badges are decorative — fill them best-effort and never
        // let a summary failure disturb the page (navBadges(null) → none).
        try {
          const summary = await fetchDashboardSummary();
          for (const badge of navBadges(summary)) {
            const el = document.querySelector<HTMLElement>(`[data-af-nav-badge="${badge.href}"]`);
            if (!el) continue;
            el.textContent = badge.text;
            el.classList.add(`af-sidebar__badge--${badge.tone}`);
            el.hidden = false;
          }
        } catch {
          // Badges stay hidden — the nav degrades to plain labels.
        }
      })();
    </script>
  </body>
</html>
