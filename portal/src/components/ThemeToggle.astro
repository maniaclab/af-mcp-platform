---
/**
 * ThemeToggle.astro — the AUTO / DARK / LIGHT theme control. Self-contained:
 * its own scoped styles and its own bundled <script> wire up ARIA state,
 * click, and arrow-key handling, so both Base.astro's sidebar and
 * PublicBase.astro's top bar can render it without either layout knowing
 * anything about theme state.
 *
 * A real `role="radiogroup"` rather than a single cycling button: AUTO,
 * DARK, and LIGHT are three genuinely distinct, always-visible states (not
 * a click-through cycle where "back to AUTO" is hidden), the way a
 * segmented control reads.
 */
import { Monitor, Moon, Sun } from '@lucide/astro';

const MODES: { value: 'auto' | 'dark' | 'light'; label: string; Icon: typeof Sun }[] = [
  { value: 'auto', label: 'Auto', Icon: Monitor },
  { value: 'dark', label: 'Dark', Icon: Moon },
  { value: 'light', label: 'Light', Icon: Sun },
];
---

<div class="theme-toggle" role="radiogroup" aria-label="Theme" data-theme-toggle>
  {
    MODES.map(({ value, label, Icon }) => (
      <button
        type="button"
        class="btn theme-toggle__option"
        data-variant="ghost"
        data-size="icon-sm"
        role="radio"
        aria-checked="false"
        aria-label={label}
        title={label}
        tabindex="-1"
        data-theme-value={value}
      >
        <Icon class="af-icon" size={16} aria-hidden="true" />
      </button>
    ))
  }
</div>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-af-border-strong);
    border-radius: var(--radius-8);
    padding: var(--space-2);
    gap: var(--space-2);
  }

  /* Basecoat's ghost icon button supplies size, shape and the focus ring; the
     radiogroup adds the secondary resting colour and the selected state. */
  .theme-toggle__option {
    color: var(--color-af-text-secondary);
    border-radius: var(--radius-4);
  }

  .theme-toggle__option:hover {
    color: var(--color-af-text);
  }

  .theme-toggle__option[aria-checked='true'] {
    color: var(--color-af-text);
    background: var(--color-af-bg-subtle);
  }
</style>

<script>
  import { getStoredMode, initTheme, setMode, type ThemeMode } from '../lib/theme';

  initTheme();

  for (const group of document.querySelectorAll<HTMLElement>('[data-theme-toggle]')) {
    const options = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-theme-value]'));

    function syncChecked(mode: ThemeMode): void {
      for (const option of options) {
        const checked = option.dataset.themeValue === mode;
        option.setAttribute('aria-checked', String(checked));
        option.tabIndex = checked ? 0 : -1;
      }
    }

    function choose(mode: ThemeMode): void {
      setMode(mode);
      syncChecked(mode);
    }

    syncChecked(getStoredMode(window.localStorage));

    options.forEach((option, index) => {
      option.addEventListener('click', () => choose(option.dataset.themeValue as ThemeMode));

      // Roving-tabindex arrow-key navigation, standard for role="radiogroup".
      option.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const delta = event.key === 'ArrowRight' ? 1 : -1;
        const next = options[(index + delta + options.length) % options.length];
        next.focus();
        choose(next.dataset.themeValue as ThemeMode);
      });
    });
  }
</script>
