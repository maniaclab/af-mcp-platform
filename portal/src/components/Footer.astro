---
/**
 * Footer.astro — shared site footer, used by both Base.astro (the
 * authenticated app shell) and PublicBase.astro (the unauthenticated
 * landing page) so the two layouts don't each carry their own copy.
 */
const appVersion = import.meta.env.PUBLIC_APP_VERSION || 'dev';
---

<footer class="af-footer" aria-label="Site footer">
  <span class="af-footer__text"
    ><span data-af-brand="facilityName">ATLAS Analysis Facility</span> · MCP Platform</span
  >
  <span class="af-footer__version">v{appVersion}</span>
  <a href="https://atlas.cern" class="af-footer__link" target="_blank" rel="noopener noreferrer">
    atlas.cern
  </a>
  <a
    href="https://giordonstark.com/"
    class="af-footer__link"
    target="_blank"
    rel="noopener noreferrer"
  >
    © Giordon Stark
  </a>
</footer>

<style>
  .af-footer {
    border-top: 1px solid var(--color-af-border);
    padding: 0 2rem;
    height: 48px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .af-footer__text {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.6875rem;
    color: var(--color-af-dim);
    letter-spacing: 0.04em;
  }

  .af-footer__link {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.6875rem;
    color: var(--color-af-dim);
    letter-spacing: 0.04em;
    text-decoration: none;
  }
  .af-footer__link:hover {
    color: var(--color-af-teal);
  }

  .af-footer__version {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.625rem;
    color: var(--color-af-dim);
    letter-spacing: 0.04em;
    opacity: 0.6;
  }
</style>

<script>
  // Self-contained: Base.astro's mount script also sweeps [data-af-brand]
  // (harmless double-apply there), but PublicBase.astro's unauthenticated
  // landing page never runs that script, and this is the only place its
  // Footer instance's facility name would otherwise get patched.
  import { getBranding } from '../lib/auth';
  import { applyBranding } from '../lib/branding';

  applyBranding(await getBranding());
</script>
