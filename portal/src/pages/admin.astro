---
import Base from '../layouts/Base.astro';
import AdminPage from '../components/AdminPage.vue';
---

<Base title="Admin">
  <div class="af-page-head">
    <div>
      <h1>Admin</h1>
      <p>Platform state across all users, for facility operators.</p>
    </div>
  </div>

  <AdminPage client:load />
</Base>

<style>
  .af-page-head {
    margin-bottom: var(--space-24);
  }

  .af-page-head h1 {
    font-size: var(--text-24);
    line-height: 1.3;
  }
</style>
