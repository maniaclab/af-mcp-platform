---
import Base from '../layouts/Base.astro';
import IdentitiesPage from '../components/IdentitiesPage.vue';
---

<Base title="Identities">
  <div class="af-page-head">
    <div>
      <h1>Identities</h1>
      <p>Link your external accounts and keep your grid certificate valid.</p>
    </div>
  </div>

  <IdentitiesPage client:load />
</Base>

<style>
  .af-page-head {
    margin-bottom: var(--space-24);
  }

  .af-page-head h1 {
    margin: 0;
    font-size: var(--text-24);
    line-height: 1.3;
  }

  .af-page-head p {
    margin: 0;
    color: var(--color-af-text-secondary);
  }
</style>
