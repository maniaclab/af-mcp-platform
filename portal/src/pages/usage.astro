---
import Base from '../layouts/Base.astro';
import UsagePage from '../components/UsagePage.vue';
---

<Base title="Usage">
  <div class="af-page-head">
    <div>
      <h1>Usage</h1>
      <p>
        What your AI assistant's tool calls put into its context through this platform. Estimates
        only: this is not your provider bill, and your prompts and the model's own output are
        invisible to the platform.
      </p>
    </div>
  </div>

  <UsagePage client:load />
</Base>
