---
// Reserved paths: /v1/* and /mcp/* are routed to the broker on this host
// (see docs/architecture.md, "Reserved paths on the portal host"). New
// portal pages must not use those prefixes.
import Base from '../layouts/Base.astro';
import ConnectClient from '../components/ConnectClient.vue';
import OverviewSummary from '../components/OverviewSummary.vue';

// Identity is filled client-side (see Base.astro) — the greeting element is
// tagged data-af-identity and stays hidden until GET /v1/identities resolves.
//
// The MCP endpoint URL is likewise filled client-side (see ConnectClient.vue)
// from getBrokerOrigin() (../lib/auth) rather than baked in here — this
// frontmatter only runs at build time, so a hardcoded URL here would show
// every deployment its own host or a different, wrong one.
---

<Base title="Overview">
  <div class="af-page">
    <!-- ── Page header: title, one sentence and the particle-track canvas beside it ── -->
    <header class="af-page-head ov-head">
      <div>
        <h1>Overview</h1>
        <p>
          A <a href="https://modelcontextprotocol.io/" target="_blank" rel="noopener noreferrer"
            >Model Context Protocol</a
          >{' '}gateway for ATLAS computing, connecting your AI assistant to Rucio, AMI, and the
          analysis grid without ever handing it your credentials.
        </p>
        <p class="ov-head__user" data-af-user-holder hidden>
          <span>Signed in as</span>
          <span data-af-identity></span>
        </p>
      </div>
      <!-- The canvas has its own cell so no text is ever drawn over it. -->
      <canvas id="track-canvas" class="ov-head__canvas" aria-hidden="true"></canvas>
    </header>

    <!-- ── Banner, status list and usage stats (Vue island — fetches live data) ── -->
    <OverviewSummary client:load />

    <!-- ── Connect a client (Vue island — endpoint comes from /config.json) ── -->
    <ConnectClient client:load />
  </div>
</Base>

<!-- ── Canvas particle track ──────────────────────────────────────────── -->
<!--
  A sparse radial event display: a handful of curved tracks originating from
  a central vertex, using quadratic Bezier curves to simulate magnetic
  curvature — the same visualization ATLAS physicists read every day.
  Shared with the public landing page's hero — see src/lib/particleTracks.ts,
  which draws one static frame under prefers-reduced-motion.
-->
<script>
  import { initParticleTracks } from '../lib/particleTracks';

  const canvas = document.getElementById('track-canvas') as HTMLCanvasElement | null;
  if (canvas) initParticleTracks(canvas);
</script>

<style is:global>
  /* The text keeps the width the canvas leaves; the canvas wraps under it only
     when the row is too narrow for both. */
  .ov-head > div {
    flex: 1 1 24rem;
    min-width: 0;
  }

  .ov-head__user {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    font-size: var(--text-13);
  }

  .ov-head__user[hidden] {
    display: none;
  }

  .ov-head__canvas {
    width: 320px;
    max-width: 100%;
    height: 96px;
    border: 1px solid var(--color-af-border);
    border-radius: var(--radius-10);
    pointer-events: none;
  }

  @media (max-width: 720px) {
    .ov-head__canvas {
      width: 100%;
    }
  }
</style>
