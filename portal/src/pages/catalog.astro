---
import Base from '../layouts/Base.astro';
import CatalogPage from '../components/CatalogPage.vue';
---

<Base title="MCP Servers">
  <div class="page-header">
    <div class="page-header__text">
      <h1 class="page-title">MCP Servers</h1>
      <p class="page-subtitle">
        MCP servers your account can reach, each exposing a set of methods (MCP "tools"). Access is
        determined by your linked identities and granted permissions.
      </p>
    </div>
  </div>

  <CatalogPage client:load />
</Base>

<style>
  .page-header {
    margin-bottom: 1.75rem;
  }

  .page-title {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-af-text);
    margin: 0 0 0.5rem;
  }

  .page-subtitle {
    font-size: 0.9375rem;
    color: var(--color-af-dim);
    line-height: 1.6;
    margin: 0;
    max-width: 52rem;
  }
</style>
