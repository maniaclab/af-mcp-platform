---
import Base from '../layouts/Base.astro';
import CatalogPage from '../components/CatalogPage.vue';
---

<Base title="Services">
  <div class="af-page-head page-head">
    <div>
      <h1>Services</h1>
      <p>Which backends and methods your account can reach, and what to do about the rest.</p>
    </div>
  </div>

  <CatalogPage client:load />
</Base>

<style>
  .page-head {
    margin-bottom: var(--space-24);
  }

  .page-head h1 {
    font-size: var(--text-24);
    line-height: 1.3;
  }

  .page-head p {
    margin: 0;
  }
</style>
