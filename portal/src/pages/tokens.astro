---
import Base from '../layouts/Base.astro';
import TokensPage from '../components/TokensPage.vue';
---

<Base title="Tokens">
  <div class="page-header">
    <h1 class="page-title">Personal Access Tokens</h1>
    <p class="page-subtitle">
      A Personal Access Token (PAT) is a long-lived credential you paste into an MCP client that
      can't sign in with a browser on its own — most clients don't need this page, since they can
      sign in themselves the first time you connect them. Mint one here, paste it into the
      client's config, and revoke it whenever you're done with it.
    </p>
    <p class="page-subtitle page-subtitle--scope">
      A PAT only grants access to this MCP platform — it's not the same as your identities with
      Rucio, CERN, or other backend systems. For those, see the
      <a href="/identities/">Identities page</a>.
    </p>
  </div>

  <TokensPage client:load />
</Base>

<style>
  .page-header {
    margin-bottom: 1.75rem;
  }

  .page-title {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-af-text);
    margin: 0 0 0.5rem;
  }

  .page-subtitle {
    font-size: 0.9375rem;
    color: var(--color-af-dim);
    line-height: 1.6;
    margin: 0;
    max-width: 52rem;
  }

  .page-subtitle--scope {
    margin-top: 0.5rem;
  }

  .page-subtitle a {
    color: var(--color-af-teal);
  }
</style>
