---
// Reserved paths: /v1/* and /mcp/* are routed to the broker on this host
// (see docs/architecture.md, "Reserved paths on the portal host"). New
// portal pages must not use those prefixes.
//
// This page is deliberately public: it uses PublicBase.astro, not Base.astro,
// so it renders with no Keycloak session and no app-shell chrome. The
// authenticated dashboard (live status, connect instructions) lives at /overview/ -- see Base.astro's nav and
// portal/src/pages/overview.astro.
import { Shield, Server, CircleCheck, ExternalLink } from '@lucide/astro';
import GatewayStatusIcon from '../components/GatewayStatusIcon.astro';
import PublicBase from '../layouts/PublicBase.astro';
---

<PublicBase title="AI access to your facility, without the credentials">
  <!-- ── Hero: particle track canvas + pitch ─────────────────────────── -->
  <section class="hero" aria-label="AF MCP Platform">
    <canvas id="track-canvas" class="hero__canvas" aria-hidden="true"></canvas>

    <div class="af-wrap">
      <div class="hero__content">
        <h1 class="hero__title">Give AI access to your analysis facility.</h1>
        <p class="hero__sub">
          Securely connect AI assistants to datasets, compute, notebooks, and analysis tools through <a
            href="https://modelcontextprotocol.io/"
            target="_blank"
            rel="noopener noreferrer">MCP</a
          >, without giving them your credentials.
        </p>

        <div class="hero__cta">
          <a href="/overview/" class="af-btn primary l">Sign in</a>
          <a href="#benefits" class="af-btn quiet l">How it works</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── What it does ──────────────────────────────────────────────────── -->
  <section id="benefits" class="benefits" aria-label="What this platform does">
    <div class="af-wrap">
      <h2 class="benefits__heading">One gateway. Your entire facility.</h2>

      <div class="benefits-layout">
        <div class="diagram" aria-label="How AI assistants reach the facility" data-pulse-diagram>
          <div class="diagram__node diagram__node--client" data-pulse-node="client">
            AI assistant
            <GatewayStatusIcon />
          </div>

          <div class="diagram__link">
            <span class="diagram__link-label">MCP</span>
          </div>

          <div class="diagram__node diagram__node--gateway" data-pulse-node="gateway">
            <span class="diagram__gateway-name">MCP gateway</span>
            <div class="diagram__gateway-tags">
              <span class="af-tag diagram__tag" data-gateway-tag="auth">
                Auth
                <GatewayStatusIcon />
              </span>
              <span class="af-tag diagram__tag" data-gateway-tag="policy">
                Policy
                <GatewayStatusIcon />
              </span>
              <span class="af-tag diagram__tag" data-gateway-tag="audit">
                Audit
                <GatewayStatusIcon />
              </span>
              <span class="af-tag diagram__tag" data-gateway-tag="broker">
                Broker
                <GatewayStatusIcon />
              </span>
            </div>
          </div>

          <div class="diagram__stem" aria-hidden="true"></div>

          <div class="diagram__fanout">
            <div class="diagram__branch" data-pulse-node="rucio">
              Rucio
              <GatewayStatusIcon />
            </div>
            <div class="diagram__branch" data-pulse-node="htcondor">
              HTCondor
              <GatewayStatusIcon />
            </div>
            <div class="diagram__branch">
              Jupyter
              <GatewayStatusIcon />
            </div>
            <div class="diagram__branch">
              Storage
              <GatewayStatusIcon />
            </div>
          </div>

          <!-- Decorative -- the "how it works" motion moment (gatewayPulse.ts). -->
          <div class="diagram__pulse" data-pulse-dot aria-hidden="true"></div>
          <div
            class="diagram__node diagram__node--credential"
            data-pulse-node="credential"
            aria-hidden="true"
          >
            <span data-credential-label>x509</span>
          </div>
          <div class="diagram__chat" data-pulse-chat aria-hidden="true">
            <div class="diagram__chat-line" data-chat-line="0">
              <span class="diagram__chat-role">User</span>
              <span class="diagram__chat-text" data-chat-text></span>
            </div>
            <div class="diagram__chat-line" data-chat-line="1">
              <span class="diagram__chat-role">AI</span>
              <span class="diagram__chat-text" data-chat-text></span>
            </div>
            <div class="diagram__chat-line" data-chat-line="2">
              <span class="diagram__chat-role">AI</span>
              <span class="diagram__chat-text" data-chat-text></span>
            </div>
          </div>
        </div>

        <div class="benefit-list">
          <div class="benefit-item">
            <Shield class="af-icon" aria-hidden="true" />
            <div class="benefit-item__body">
              <h3 class="benefit-item__title">Credentials stay behind the broker</h3>
              <p class="benefit-item__desc">
                Short-lived credentials are issued per call. Raw tokens and certificates never reach
                the AI assistant.
              </p>
            </div>
          </div>

          <div class="benefit-item">
            <Server class="af-icon" aria-hidden="true" />
            <div class="benefit-item__body">
              <h3 class="benefit-item__title">Add methods, not complexity</h3>
              <p class="benefit-item__desc">
                Add MCP services through configuration. Give users one endpoint for datasets, jobs,
                notebooks, storage, and more.
              </p>
            </div>
          </div>

          <div class="benefit-item">
            <CircleCheck class="af-icon" aria-hidden="true" />
            <div class="benefit-item__body">
              <h3 class="benefit-item__title">Authorize every call</h3>
              <p class="benefit-item__desc">
                Group-based access controls and audit logging govern every method invocation.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Ecosystem proof ───────────────────────────────────────────────── -->
  <section class="proof" aria-label="Deployed today">
    <div class="af-wrap">
      <div class="landing-col">
        <h2 class="proof__heading">Already running at UChicago</h2>
        <p class="proof__body">
          The UChicago ATLAS Analysis Facility uses MCP Platform today to securely expose Rucio,
          AMI, HTCondor, JupyterLab, and filesystem access to AI-powered workflows.
        </p>
        <a
          href="https://maniaclab.github.io/af-mcp-platform/ecosystem/"
          class="proof__link"
          target="_blank"
          rel="noopener noreferrer"
        >
          See the deployed ecosystem
          <ExternalLink class="af-icon" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <!-- Closing action: secondary weight, because the page's one primary
       button is the hero's Sign in. -->
  <section class="final-cta" aria-label="Get started">
    <div class="af-wrap">
      <div class="landing-col">
        <h2 class="final-cta__heading">Bring AI to your analysis facility.</h2>
        <p class="final-cta__sub">
          Connect your assistant to datasets, compute, notebooks, and tools, without giving it your
          credentials.
        </p>
        <a href="/overview/" class="af-btn secondary">Sign in</a>
      </div>
    </div>
  </section>
</PublicBase>

<!-- ── Canvas particle track (the aesthetic risk) ─────────────────────── -->
<!--
  A sparse radial event display: a handful of curved tracks originating from
  a central vertex, using quadratic Bezier curves to simulate magnetic
  curvature — the same visualization ATLAS physicists read every day.
  One orchestrated moment; the rest of the page is quiet. Deliberately
  duplicated from overview.astro rather than shared, to keep this page's
  addition scoped to this file alone -- see the PR description for why.
-->
<!--
  The particle-track canvas is shared with the authenticated Overview page's
  hero — see src/lib/particleTracks.ts for the geometry/palette/draw-loop
  logic (a golden-angle-spaced radial event display, quadratic Bezier
  "magnetic curvature," teal/amber/ink palette assignment matching
  Cherenkov/EM-calorimeter physics). `prefers-reduced-motion` renders one
  static frame instead of animating.
-->
<script>
  import { initParticleTracks } from '../lib/particleTracks';

  const canvas = document.getElementById('track-canvas') as HTMLCanvasElement | null;
  if (canvas) initParticleTracks(canvas);
</script>

<!-- ── Gateway pulse (the "how it works" diagram's motion moment) ─────── -->
<script>
  import { initGatewayPulse } from '../lib/gatewayPulse';

  const diagram = document.querySelector<HTMLElement>('[data-pulse-diagram]');
  if (diagram) {
    const cleanup = initGatewayPulse(diagram);
    window.addEventListener('beforeunload', cleanup, { once: true });
  }
</script>

<style>
  /* ── Hero ──────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-af-border);
    padding-block: var(--space-64);
  }

  /* A quiet backdrop: faint enough that text keeps AA contrast over it. */
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.35;
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .hero__title {
    font-size: var(--text-32);
    line-height: 1.25;
    margin: 0;
  }

  .hero__sub {
    font-size: var(--text-16);
    line-height: 1.55;
    color: var(--color-af-text-secondary);
    margin: 0;
  }

  .hero__sub a {
    color: var(--color-af-text);
    text-underline-offset: 3px;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-12);
    margin-top: var(--space-16);
  }

  /* ── Benefits ──────────────────────────────────────────────────────── */
  .benefits {
    padding-block: var(--space-64);
  }

  .benefits__heading {
    font-size: var(--text-24);
    line-height: 1.3;
    margin: 0 0 var(--space-48);
  }

  .benefits-layout {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    align-items: center;
    gap: var(--space-48);
  }

  .benefit-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .benefit-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-12);
  }

  /* Centres the 16px icon on the first 24px line of the heading. */
  .benefit-item > .af-icon {
    margin-top: var(--space-4);
  }

  .benefit-item__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .benefit-item__title {
    font-size: var(--text-16);
    line-height: 1.5;
    margin: 0;
  }

  .benefit-item__desc {
    font-size: var(--text-14);
    color: var(--color-af-text-secondary);
    margin: 0;
  }

  /* ── Architecture diagram ─────────────────────────────────────────── */
  /* position: relative -- anchors the pulse dot and callouts (gatewayPulse.ts),
     which are positioned in JS via getBoundingClientRect() math relative to
     this element's own box. */
  .diagram {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
  }

  .diagram__node {
    font-size: var(--text-14);
    color: var(--color-af-text);
    background: var(--color-af-bg);
    border: 1px solid var(--color-af-border-strong);
    border-radius: var(--radius-8);
    padding: var(--space-8) var(--space-16);
    transition:
      border-color var(--time-base) var(--ease),
      background var(--time-base) var(--ease);
  }

  /* Toggled by gatewayPulse.ts as the light passes through each box --
     declarative CSS transition rather than a JS-driven tween, since it's
     just a binary highlight/unhighlight. */
  .diagram__node.is-pulse-active,
  .diagram__branch.is-pulse-active {
    border-color: var(--color-af-text);
    background: var(--color-af-bg-subtle);
  }

  /* The denied-request cycle's gateway state -- swapped in for
     is-pulse-active once Policy/Audit fail (their x icons show the same
     outcome), swapped back out before the dot returns to the AI assistant
     box. */
  .diagram__node.is-pulse-denied {
    border-color: var(--color-af-bad);
    animation: diagram-denied-buzz 160ms ease-in-out 3;
  }

  @keyframes diagram-denied-buzz {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(var(--space-4));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .diagram__node.is-pulse-denied {
      animation: none;
    }
  }

  .diagram__node--client {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
  }

  .diagram__node--gateway {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
    padding: var(--space-16) var(--space-32);
    border-radius: var(--radius-10);
  }

  .diagram__gateway-name {
    font-weight: 600;
    font-size: var(--text-16);
  }

  .diagram__gateway-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-8);
  }

  .diagram__tag {
    gap: var(--space-4);
  }

  .diagram__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-8) 0;
  }

  .diagram__link::before,
  .diagram__link::after {
    content: '';
    width: 1px;
    height: var(--space-16);
    background: var(--color-af-border-strong);
  }

  .diagram__link-label {
    font-size: var(--text-12);
    color: var(--color-af-text-secondary);
  }

  .diagram__stem {
    width: 1px;
    height: var(--space-24);
    background: var(--color-af-border-strong);
  }

  .diagram__fanout {
    display: flex;
    justify-content: center;
    gap: var(--space-16);
    width: 100%;
    padding-top: var(--space-24);
    border-top: 1px solid var(--color-af-border-strong);
  }

  .diagram__branch {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    font-size: var(--text-14);
    color: var(--color-af-text);
    background: var(--color-af-bg);
    border: 1px solid var(--color-af-border-strong);
    border-radius: var(--radius-8);
    padding: var(--space-8) var(--space-12);
    transition:
      border-color var(--time-base) var(--ease),
      background var(--time-base) var(--ease);
  }

  .diagram__branch::before {
    content: '';
    position: absolute;
    top: calc(-1 * var(--space-24));
    left: 50%;
    width: 1px;
    height: var(--space-24);
    background: var(--color-af-border-strong);
  }

  /* Decorative pulse dot + callouts (gatewayPulse.ts) -- positioned via JS
     with GSAP's x/y (transform, not top/left, so moving them never
     triggers layout), hidden by default so a script failure or
     prefers-reduced-motion leaves the diagram exactly as it already reads
     without either. */
  .diagram__pulse {
    position: absolute;
    top: 0;
    left: 0;
    width: 8px;
    height: 8px;
    margin: -4px;
    border-radius: 50%;
    background: var(--color-af-text);
    opacity: 0;
    pointer-events: none;
  }

  /* The credential box (x509 / condor-token) -- reuses .diagram__node's
     look, positioned via JS once per cycle (gsap.set, not a continuous
     tween) beside the gateway box; only two of this session's three
     cycles ever light it up. */
  .diagram__node--credential {
    position: absolute;
    top: 0;
    left: 0;
    font-size: var(--text-12);
    padding: var(--space-4) var(--space-8);
    opacity: 0;
    pointer-events: none;
  }

  /* The label is a literal credential type (x509, condor-token). */
  .diagram__node--credential [data-credential-label] {
    font-family: var(--font-mono);
  }

  /* The growing "chat log" beside the AI assistant box -- one to three
     lines revealed in sequence and held on screen for the rest of the
     cycle, then collapsed together at the reset. height: 0 -> 'auto'
     (not max-height) is what lets GSAP measure and animate each line's
     real content height. */
  .diagram__chat {
    position: absolute;
    top: 0;
    right: calc(-1 * var(--space-32));
    display: flex;
    flex-direction: column;
    width: 15rem;
    pointer-events: none;
  }

  .diagram__chat-line {
    display: flex;
    align-items: baseline;
    gap: var(--space-8);
    height: 0;
    overflow: hidden;
    opacity: 0;
    font-size: var(--text-12);
    padding: 0 var(--space-8);
    border-left: 1px solid var(--color-af-border-strong);
  }

  .diagram__chat-role {
    flex-shrink: 0;
    font-weight: 500;
  }

  .diagram__chat-text {
    color: var(--color-af-text-secondary);
  }

  /* ── Proof and closing action ──────────────────────────────────────── */
  .proof {
    padding-block: var(--space-48);
  }

  .landing-col {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-12);
  }

  .proof__heading,
  .final-cta__heading {
    font-size: var(--text-20);
    line-height: 1.3;
    margin: 0;
  }

  .proof__body,
  .final-cta__sub {
    font-size: var(--text-16);
    line-height: 1.55;
    color: var(--color-af-text-secondary);
    margin: 0;
  }

  .proof__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    color: var(--color-af-text);
    text-underline-offset: 3px;
  }

  .final-cta {
    padding-block: var(--space-48) var(--space-64);
  }

  .final-cta .af-btn {
    margin-top: var(--space-12);
  }

  /* ── Responsive ────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .benefits-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-48);
    }
  }

  @media (max-width: 640px) {
    .hero,
    .benefits {
      padding-block: var(--space-48);
    }
    .diagram__fanout {
      flex-direction: column;
      align-items: center;
      gap: var(--space-24);
    }
    /* The chat log and credential box assume horizontal room beside the
       diagram's centerline that a single narrow column doesn't have -- the
       pulse dot and box/tag highlights alone still read fine without
       them. */
    .diagram__chat,
    .diagram__node--credential {
      display: none;
    }
  }
</style>
