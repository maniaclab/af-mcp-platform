---
// Reserved paths: /v1/* and /mcp/* are routed to the broker on this host
// (see docs/architecture.md, "Reserved paths on the portal host"). New
// portal pages must not use those prefixes.
//
// This page is deliberately public: it uses PublicBase.astro, not Base.astro,
// so it renders with no Keycloak session and no app-shell chrome. The
// authenticated dashboard (identical hero, live status, connect
// instructions) lives at /overview/ -- see Base.astro's nav and
// portal/src/pages/overview.astro.
import PublicBase from '../layouts/PublicBase.astro';
---

<PublicBase title="AF MCP Platform">
  <!-- ── Hero: particle track canvas + pitch ─────────────────────────── -->
  <section class="hero" aria-label="AF MCP Platform">
    <canvas id="track-canvas" class="hero__canvas" aria-hidden="true"></canvas>

    <div class="hero__content">
      <div class="hero__eyebrow">Credential-brokered MCP gateway</div>
      <h1 class="hero__title">MCP Platform</h1>
      <p class="hero__sub">
        Connect an AI assistant to your analysis facility's computing — dataset lookup, job
        submission, notebooks, and more — through the open
        <a href="https://modelcontextprotocol.io/" target="_blank" rel="noopener noreferrer"
          >Model Context Protocol</a
        >, without ever handing that assistant a raw credential.
      </p>

      <div class="hero__cta">
        <a href="/overview/" class="hero__cta-primary">Sign in →</a>
        <a
          href="https://github.com/maniaclab/af-mcp-platform"
          class="hero__cta-secondary"
          target="_blank"
          rel="noopener noreferrer"
        >
          View on GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- ── What it does ──────────────────────────────────────────────────── -->
  <section class="benefits" aria-label="What this platform does">
    <div class="benefit">
      <svg
        class="benefit__icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M12 3l7 3v5.2c0 4.3-2.9 8.2-7 9.8-4.1-1.6-7-5.5-7-9.8V6l7-3z" />
      </svg>
      <h2 class="benefit__title">Credentials never leave the broker</h2>
      <p class="benefit__desc">
        Your AI assistant never holds a raw grid certificate or IAM token. The broker mints
        short-lived, per-call credentials behind the scenes and hands the assistant only a
        result.
      </p>
    </div>

    <div class="benefit">
      <svg
        class="benefit__icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M4 4.5h16v6.5H4z" /><path d="M4 13h16v6.5H4z" /><path d="M7.5 7.75h.01" /><path
          d="M7.5 16.25h.01"
        />
      </svg>
      <h2 class="benefit__title">Add a backend, not a deployment</h2>
      <p class="benefit__desc">
        Registering a new MCP server is a config entry, not a code change — the platform grows to
        cover any number of computing tools behind one endpoint.
      </p>
    </div>

    <div class="benefit">
      <svg
        class="benefit__icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z" /><path d="M8.5 12.5l2.5 2.5 4.5-5" />
      </svg>
      <h2 class="benefit__title">Every call is authorized and audited</h2>
      <p class="benefit__desc">
        Group-based capabilities decide what you can reach; every tool invocation is checked and
        logged before it reaches a backend.
      </p>
    </div>
  </section>

  <!-- ── Ecosystem proof ───────────────────────────────────────────────── -->
  <section class="proof" aria-label="Deployed today">
    <h2 class="proof__heading">A real, working deployment</h2>
    <p class="proof__body">
      This is the reference deployment for the UChicago ATLAS Analysis Facility — not a demo.
      Rucio and AMI dataset tools, HTCondor job submission, JupyterLab management, and grid
      filesystem access all run behind it today, each backed by its own independently-maintained
      MCP server and credential service. Any facility can deploy the same broker + portal chart
      with its own mix.
    </p>
    <a
      href="https://maniaclab.github.io/af-mcp-platform/ecosystem/"
      class="proof__link"
      target="_blank"
      rel="noopener noreferrer"
    >
      See what's deployed →
    </a>
  </section>

  <!-- ── Final CTA ─────────────────────────────────────────────────────── -->
  <section class="final-cta" aria-label="Get started">
    <h2 class="final-cta__heading">Ready to connect your AI assistant?</h2>
    <a href="/overview/" class="hero__cta-primary">Sign in →</a>
  </section>
</PublicBase>

<!-- ── Canvas particle track (the aesthetic risk) ─────────────────────── -->
<!--
  A sparse radial event display: a handful of curved tracks originating from
  a central vertex, using quadratic Bezier curves to simulate magnetic
  curvature — the same visualization ATLAS physicists read every day.
  One orchestrated moment; the rest of the page is quiet. Deliberately
  duplicated from overview.astro rather than shared, to keep this page's
  addition scoped to this file alone -- see the PR description for why.
-->
<script>
  (function () {
    interface Track {
      angle: number;
      curvature: number;
      length: number;
      palette: string;
      alpha: number;
      lineWidth: number;
      phase: number;
    }

    // Cast to non-null after the runtime guards so TS keeps them narrowed
    // inside the resize()/draw() closures (control-flow narrowing of a `| null`
    // const is not carried into nested functions).
    const canvas = document.getElementById('track-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d') as CanvasRenderingContext2D;
    if (!ctx) return;
    let W: number, H: number, tracks: Track[];
    let animId = 0;

    const TRACK_COUNT = 18;
    const TEAL = 'rgba(0, 212, 200,';
    const AMBER = 'rgba(245, 158, 11,';
    const WHITE = 'rgba(232, 236, 240,';

    function resize() {
      W = canvas.offsetWidth;
      H = canvas.offsetHeight;
      canvas.width = W * devicePixelRatio;
      canvas.height = H * devicePixelRatio;
      ctx.scale(devicePixelRatio, devicePixelRatio);
    }

    function buildTracks() {
      tracks = [];
      // Golden angle spacing: produces a naturally spread radial distribution
      // that resembles a real ATLAS event display cross-section.
      const goldenAngle = Math.PI * (3 - Math.sqrt(5));
      for (let i = 0; i < TRACK_COUNT; i++) {
        const angle = i * goldenAngle;
        const curvature = (Math.random() - 0.5) * 0.6;
        const length = 0.2 + Math.random() * 0.45;
        // Mostly teal (Cherenkov) with occasional amber (EM calorimeter)
        const palette = i % 7 === 0 ? AMBER : i % 11 === 0 ? WHITE : TEAL;
        const alpha = 0.15 + Math.random() * 0.45;
        const lineWidth = 0.5 + Math.random() * 0.8;
        const phase = Math.random() * Math.PI * 2;
        tracks.push({ angle, curvature, length, palette, alpha, lineWidth, phase });
      }
    }

    let t = 0;
    function draw() {
      ctx.clearRect(0, 0, W, H);

      const cx = W * 0.5;
      const cy = H * 0.5;
      const R = Math.min(W, H) * 0.44;

      // Faint vertex point
      ctx.beginPath();
      ctx.arc(cx, cy, 3, 0, Math.PI * 2);
      // Canvas 2D API cannot resolve CSS custom properties or relative-colour
      // syntax, so these one-off fills stay as literal rgba(). If the AF palette
      // changes, update these to match the new --color-af-teal / --color-af-border.
      ctx.fillStyle = 'rgba(0, 212, 200, 0.35)';
      ctx.fill();

      // Concentric barrel rings — pixel-thin, structural not decorative
      [0.28, 0.55, 0.82, 1.0].forEach((f) => {
        ctx.beginPath();
        ctx.arc(cx, cy, R * f, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(31, 41, 55, 0.7)';
        ctx.lineWidth = 0.5;
        ctx.stroke();
      });

      tracks.forEach((tr) => {
        // Gentle oscillation — drifting, not bouncing
        const drift = Math.sin(t * 0.4 + tr.phase) * 0.015;
        const a = tr.angle + drift;
        const maxR = R * tr.length;

        const x1 = cx;
        const y1 = cy;
        const x2 = cx + Math.cos(a) * maxR;
        const y2 = cy + Math.sin(a) * maxR;

        // Perpendicular offset for curvature control point
        const mx = (x1 + x2) / 2;
        const my = (y1 + y2) / 2;
        const perp = { x: -(y2 - y1), y: x2 - x1 };
        const plen = Math.sqrt(perp.x ** 2 + perp.y ** 2);
        const cpx = mx + (perp.x / plen) * maxR * tr.curvature;
        const cpy = my + (perp.y / plen) * maxR * tr.curvature;

        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.quadraticCurveTo(cpx, cpy, x2, y2);
        ctx.strokeStyle = `${tr.palette} ${tr.alpha})`;
        ctx.lineWidth = tr.lineWidth;
        ctx.stroke();
      });

      t += 1;
      animId = requestAnimationFrame(draw);
    }

    // Respect prefers-reduced-motion: render one static frame, no animation
    const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

    resize();
    buildTracks();

    if (motionOK) {
      draw();
    } else {
      t = 60;
      draw();
      cancelAnimationFrame(animId);
    }

    window.addEventListener('resize', () => {
      resize();
      if (!motionOK) {
        draw();
        cancelAnimationFrame(animId);
      }
    });
  })();
</script>

<style>
  /* ── Hero ──────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 320px;
    overflow: hidden;
    border-bottom: 1px solid var(--color-af-border);
    background: var(--color-af-void);
    display: flex;
    align-items: center;
    padding: 0 2rem;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 42rem;
    margin: 0 auto;
    padding: 3rem 0;
  }

  .hero__eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-af-teal);
    margin-bottom: 0.75rem;
  }

  .hero__title {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--color-af-text);
    line-height: 1.05;
    margin: 0 0 1rem;
  }

  .hero__sub {
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    font-size: 1rem;
    color: var(--color-af-dim);
    line-height: 1.65;
    margin: 0 0 1.75rem;
  }

  .hero__sub a {
    color: var(--color-af-teal);
  }

  .hero__cta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .hero__cta-primary {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-af-void);
    background: var(--color-af-teal);
    padding: 0.625rem 1.25rem;
    border-radius: 4px;
    text-decoration: none;
    transition: opacity 150ms;
  }
  .hero__cta-primary:hover,
  .hero__cta-primary:focus-visible {
    opacity: 0.85;
  }

  .hero__cta-secondary {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8125rem;
    color: var(--color-af-dim);
    text-decoration: none;
    transition: color 150ms;
  }
  .hero__cta-secondary:hover,
  .hero__cta-secondary:focus-visible {
    color: var(--color-af-teal);
  }

  /* ── Benefits ──────────────────────────────────────────────────────── */
  .benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    max-width: 68rem;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .benefit {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .benefit__icon {
    width: 22px;
    height: 22px;
    color: var(--color-af-teal);
  }

  .benefit__title {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-af-text);
    margin: 0;
  }

  .benefit__desc {
    font-size: 0.875rem;
    color: var(--color-af-dim);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Proof ─────────────────────────────────────────────────────────── */
  .proof {
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem 2rem 3rem;
    text-align: center;
  }

  .proof__heading {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-af-text);
    margin: 0 0 0.75rem;
  }

  .proof__body {
    font-size: 0.9375rem;
    color: var(--color-af-dim);
    line-height: 1.65;
    margin: 0 0 1rem;
  }

  .proof__link {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8125rem;
    color: var(--color-af-teal);
    text-decoration: none;
  }
  .proof__link:hover,
  .proof__link:focus-visible {
    text-decoration: underline;
  }

  /* ── Final CTA ─────────────────────────────────────────────────────── */
  .final-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    padding: 3rem 2rem 4rem;
    border-top: 1px solid var(--color-af-border);
  }

  .final-cta__heading {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-af-text);
    margin: 0;
    text-align: center;
  }

  /* ── Responsive ────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .benefits {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 260px;
      padding: 0 1.5rem;
    }
    .hero__title {
      font-size: 2rem;
    }
    .hero__cta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
