  <!-- ── Ecosystem proof ───────────────────────────────────────────────── -->
  <section class="proof" aria-label="Deployed today">
    <h2 class="proof__heading">Already running at UChicago</h2>
    <p class="proof__lead">This isn't a demo.</p>
    <p class="proof__body">
      The UChicago ATLAS Analysis Facility uses MCP Platform today to securely expose Rucio, AMI,
      HTCondor, JupyterLab, and filesystem access to AI-powered workflows.
    </p>
    <a
      href="https://maniaclab.github.io/af-mcp-platform/ecosystem/"
      class="proof__link"
      target="_blank"
      rel="noopener noreferrer"
    >
      See the deployed ecosystem →
    </a>
  </section>

  <!-- ── Final CTA ─────────────────────────────────────────────────────── -->
  <section class="final-cta" aria-label="Get started">
    <h2 class="final-cta__heading">Bring AI to your analysis facility.</h2>
    <p class="final-cta__sub">
      Connect your assistant to datasets, compute, notebooks, and tools, without giving it your
      credentials.
    </p>
    <a href="/overview/" class="hero__cta-primary">Sign in →</a>
  </section>
</PublicBase>

<!-- ── Canvas particle track (the aesthetic risk) ─────────────────────── -->
<!--
  A sparse radial event display: a handful of curved tracks originating from
  a central vertex, using quadratic Bezier curves to simulate magnetic
  curvature — the same visualization ATLAS physicists read every day.
  One orchestrated moment; the rest of the page is quiet. Deliberately
  duplicated from overview.astro rather than shared, to keep this page's
  addition scoped to this file alone -- see the PR description for why.
-->
<script>
  (function () {
    interface Track {
      angle: number;
      curvature: number;
      length: number;
      palette: string;
      alpha: number;
      lineWidth: number;
      phase: number;
    }

    // Cast to non-null after the runtime guards so TS keeps them narrowed
    // inside the resize()/draw() closures (control-flow narrowing of a `| null`
    // const is not carried into nested functions).
    const canvas = document.getElementById('track-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d') as CanvasRenderingContext2D;
    if (!ctx) return;
    let W: number, H: number, tracks: Track[];
    let animId = 0;

    const TRACK_COUNT = 18;
    const TEAL = 'rgba(0, 212, 200,';
    const AMBER = 'rgba(245, 158, 11,';
    const WHITE = 'rgba(232, 236, 240,';

    function resize() {
      W = canvas.offsetWidth;
      H = canvas.offsetHeight;
      canvas.width = W * devicePixelRatio;
      canvas.height = H * devicePixelRatio;
      ctx.scale(devicePixelRatio, devicePixelRatio);
    }

    function buildTracks() {
      tracks = [];
      // Golden angle spacing: produces a naturally spread radial distribution
      // that resembles a real ATLAS event display cross-section.
      const goldenAngle = Math.PI * (3 - Math.sqrt(5));
      for (let i = 0; i < TRACK_COUNT; i++) {
        const angle = i * goldenAngle;
        const curvature = (Math.random() - 0.5) * 0.6;
        const length = 0.2 + Math.random() * 0.45;
        // Mostly teal (Cherenkov) with occasional amber (EM calorimeter)
        const palette = i % 7 === 0 ? AMBER : i % 11 === 0 ? WHITE : TEAL;
        const alpha = 0.15 + Math.random() * 0.45;
        const lineWidth = 0.5 + Math.random() * 0.8;
        const phase = Math.random() * Math.PI * 2;
        tracks.push({ angle, curvature, length, palette, alpha, lineWidth, phase });
      }
    }

    let t = 0;
    function draw() {
      ctx.clearRect(0, 0, W, H);

      const cx = W * 0.5;
      const cy = H * 0.5;
      const R = Math.min(W, H) * 0.44;

      // Faint vertex point
      ctx.beginPath();
      ctx.arc(cx, cy, 3, 0, Math.PI * 2);
      // Canvas 2D API cannot resolve CSS custom properties or relative-colour
      // syntax, so these one-off fills stay as literal rgba(). If the AF palette
      // changes, update these to match the new --color-af-teal / --color-af-border.
      ctx.fillStyle = 'rgba(0, 212, 200, 0.35)';
      ctx.fill();

      // Concentric barrel rings — pixel-thin, structural not decorative
      [0.28, 0.55, 0.82, 1.0].forEach((f) => {
        ctx.beginPath();
        ctx.arc(cx, cy, R * f, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(31, 41, 55, 0.7)';
        ctx.lineWidth = 0.5;
        ctx.stroke();
      });

      tracks.forEach((tr) => {
        // Gentle oscillation — drifting, not bouncing
        const drift = Math.sin(t * 0.4 + tr.phase) * 0.015;
        const a = tr.angle + drift;
        const maxR = R * tr.length;

        const x1 = cx;
        const y1 = cy;
        const x2 = cx + Math.cos(a) * maxR;
        const y2 = cy + Math.sin(a) * maxR;

        // Perpendicular offset for curvature control point
        const mx = (x1 + x2) / 2;
        const my = (y1 + y2) / 2;
        const perp = { x: -(y2 - y1), y: x2 - x1 };
        const plen = Math.sqrt(perp.x ** 2 + perp.y ** 2);
        const cpx = mx + (perp.x / plen) * maxR * tr.curvature;
        const cpy = my + (perp.y / plen) * maxR * tr.curvature;

        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.quadraticCurveTo(cpx, cpy, x2, y2);
        ctx.strokeStyle = `${tr.palette} ${tr.alpha})`;
        ctx.lineWidth = tr.lineWidth;
        ctx.stroke();
      });

      t += 1;
      animId = requestAnimationFrame(draw);
    }

    // Respect prefers-reduced-motion: render one static frame, no animation
    const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

    resize();
    buildTracks();

    if (motionOK) {
      draw();
    } else {
      t = 60;
      draw();
      cancelAnimationFrame(animId);
    }

    window.addEventListener('resize', () => {
      resize();
      if (!motionOK) {
        draw();
        cancelAnimationFrame(animId);
      }
    });
  })();
</script>

<!-- ── Gateway pulse (the "how it works" diagram's motion moment) ─────── -->
<script>
  import { initGatewayPulse } from '../lib/gatewayPulse';

  const diagram = document.querySelector<HTMLElement>('[data-pulse-diagram]');
  if (diagram) {
    const cleanup = initGatewayPulse(diagram);
    window.addEventListener('beforeunload', cleanup, { once: true });
  }
</script>

<style>
  /* ── Hero ──────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 320px;
    overflow: hidden;
    border-bottom: 1px solid var(--color-af-border);
    background: var(--color-af-void);
    display: flex;
    align-items: center;
    padding: 0 2rem;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 42rem;
    margin: 0 auto;
    padding: 3rem 0;
  }

  .hero__eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-af-teal);
    margin-bottom: 0.75rem;
  }

  .hero__title {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--color-af-text);
    line-height: 1.05;
    margin: 0 0 1rem;
  }

  .hero__sub {
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    font-size: 1rem;
    color: var(--color-af-dim);
    line-height: 1.65;
    margin: 0 0 1.75rem;
  }

  .hero__sub a {
    color: var(--color-af-teal);
  }

  .hero__cta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .hero__cta-primary {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-af-void);
    background: var(--color-af-teal);
    padding: 0.625rem 1.25rem;
    border-radius: 4px;
    text-decoration: none;
    transition: opacity 150ms;
  }
  .hero__cta-primary:hover,
  .hero__cta-primary:focus-visible {
    opacity: 0.85;
  }

  .hero__cta-secondary {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8125rem;
    color: var(--color-af-dim);
    text-decoration: none;
    transition: color 150ms;
  }
  .hero__cta-secondary:hover,
  .hero__cta-secondary:focus-visible {
    color: var(--color-af-teal);
  }

  /* ── Benefits ──────────────────────────────────────────────────────── */
  .benefits {
    max-width: 68rem;
    margin: 0 auto;
    padding: 3.5rem 2rem;
  }

  .benefits__heading {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-af-text);
    text-align: center;
    margin: 0 0 2.5rem;
  }

  .benefits-layout {
    display: grid;
    grid-template-columns: 3fr 2fr;
    align-items: center;
    gap: 3rem;
  }

  .benefit-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
  }

  .benefit-item__icon {
    width: 22px;
    height: 22px;
    color: var(--color-af-teal);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .benefit-item__body {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .benefit-item__title {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-af-text);
    margin: 0;
  }

  .benefit-item__desc {
    font-size: 0.875rem;
    color: var(--color-af-dim);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Architecture diagram ─────────────────────────────────────────── */
  /* position: relative -- anchors the pulse dot and callouts (gatewayPulse.ts),
     which are positioned in JS via getBoundingClientRect() math relative to
     this element's own box. */
  .diagram {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .diagram__node {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8125rem;
    color: var(--color-af-text);
    background: var(--color-af-surface);
    border: 1px solid var(--color-af-border);
    border-radius: 4px;
    padding: 0.625rem 1.5rem;
    transition:
      border-color 200ms,
      box-shadow 200ms;
  }

  /* Toggled by gatewayPulse.ts as the light passes through each box --
     declarative CSS transition rather than a JS-driven tween, since it's
     just a binary highlight/unhighlight. */
  .diagram__node.is-pulse-active,
  .diagram__branch.is-pulse-active {
    border-color: var(--color-af-teal);
    box-shadow: 0 0 16px 2px rgb(from var(--color-af-teal) r g b / 0.3);
  }

  /* The denied-request cycle's gateway state -- swapped in for
     is-pulse-active once Policy/Audit fail, swapped back out before the
     dot returns to the AI Assistant box. */
  .diagram__node.is-pulse-denied {
    border-color: var(--color-af-red);
    box-shadow: 0 0 16px 2px rgb(from var(--color-af-red) r g b / 0.3);
  }

  .diagram__node--client {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    color: var(--color-af-dim);
  }

  .diagram__node--gateway {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    padding: 1rem 2rem;
    border-color: var(--color-af-teal);
  }

  .diagram__gateway-name {
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
  }

  .diagram__gateway-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .diagram__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-af-label);
    border: 1px solid var(--color-af-border);
    border-radius: 2px;
    padding: 0.1875rem 0.5rem;
  }

  /* Status slot shared by the four gateway tags and the Rucio/HTCondor
     leaf boxes -- three pre-rendered states (spinner/check/x), toggled via
     the parent's data-state attribute rather than swapping DOM/innerHTML,
     so gatewayPulse.ts only ever sets one attribute per state change. The
     spinner reuses this app's established loading-spinner construct
     (a bordered circle, one side recolored, rotated) rather than a glyph --
     DESIGN.md bans unicode/emoji standing in for icons. */
