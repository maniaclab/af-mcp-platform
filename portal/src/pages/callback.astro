---
/**
 * callback.astro — OIDC Authorization Code redirect target.
 *
 * Keycloak redirects here with `?code=&state=` after the user (silently or
 * interactively) authenticates. handleCallback() (see ../lib/auth) exchanges
 * the code for tokens and returns the path the user started from; on success
 * we replace the current entry with that path so the callback URL never ends
 * up in browser history. On failure (state mismatch, a 4xx from the token
 * endpoint, a network error) we render an inline error with a link back to
 * `/overview/` (not the public `/` landing page, which never runs a login
 * check at all), which re-initiates the flow from scratch via Base.astro's
 * own getUser()-or-login() check.
 *
 * Rendered inside Base so the shared nav/footer chrome is consistent — Base's
 * inline script special-cases this path (see layouts/Base.astro) so it
 * doesn't also try to redirect to Keycloak while this exchange is in flight.
 */
import Base from '../layouts/Base.astro';
---

<Base title="Signing in">
  <div class="cb">
    <h1 class="cb__title">Signing in</h1>

    <div id="callback-status" class="cb__status" role="status">
      <span class="cb__spinner" aria-hidden="true"></span>
      <span>Completing sign-in…</span>
    </div>

    <div id="callback-error" class="af-banner bad cb__error" role="alert" hidden>
      <span class="af-mark bad" aria-hidden="true"></span>
      <div>
        <b>Sign-in failed</b>
        <span id="callback-error-message"></span>
      </div>
      <a href="/overview/" class="af-btn s">Try again</a>
    </div>
  </div>
</Base>

<script>
  import { clearIdentitiesCache } from '../lib/api';
  import { handleCallback } from '../lib/auth';

  (async () => {
    const statusEl = document.getElementById('callback-status');
    const errorEl = document.getElementById('callback-error');
    const messageEl = document.getElementById('callback-error-message');

    try {
      const returnUrl = await handleCallback();
      // Covers both a normal sign-in and a LINK_IDP callback. In the LINK_IDP
      // case this drops the pre-link identities snapshot so the target page
      // fetches fresh data reflecting the newly-linked provider instead of
      // serving the stale cache for up to its TTL; a normal sign-in clearing
      // an (empty or absent) cache is a harmless no-op.
      clearIdentitiesCache();
      window.location.replace(returnUrl);
    } catch (err) {
      if (statusEl) statusEl.hidden = true;
      if (errorEl) errorEl.hidden = false;
      if (messageEl) {
        messageEl.textContent = err instanceof Error ? err.message : 'Unknown error.';
      }
    }
  })();
</script>

<style>
  .cb {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-16);
    padding-block: var(--space-64);
    text-align: center;
  }

  .cb__title {
    font-size: var(--text-24);
    line-height: 1.3;
    margin: 0;
  }

  .cb__status {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    color: var(--color-af-text-secondary);
  }

  /* Same ring as the loading row in ui/AsyncState.vue, whose scoped styles
     do not reach an .astro page. */
  .cb__spinner {
    width: 16px;
    height: 16px;
    flex: none;
    border: 2px solid var(--color-af-border-strong);
    border-top-color: var(--color-af-text-secondary);
    border-radius: 50%;
    animation: cb-spin 0.8s linear infinite;
  }

  @keyframes cb-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* A frozen ring still reads as "working" next to the label. */
  @media (prefers-reduced-motion: reduce) {
    .cb__spinner {
      animation: none;
    }
  }

  .cb__error {
    width: min(100%, 560px);
    text-align: left;
  }
</style>
