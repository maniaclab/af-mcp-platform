---
import Base from '../layouts/Base.astro';
import EntitlementsPage from '../components/EntitlementsPage.vue';
---

<Base title="Entitlements">
  <div class="page-header">
    <h1 class="page-title">Entitlements</h1>
    <p class="page-subtitle">
      What each group on this platform grants, and which ones you're currently in.
    </p>
  </div>

  <EntitlementsPage client:load />
</Base>

<style>
  .page-header {
    margin-bottom: 1.75rem;
  }

  .page-title {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-af-text);
    margin: 0 0 0.5rem;
  }

  .page-subtitle {
    font-size: 0.9375rem;
    color: var(--color-af-dim);
    line-height: 1.6;
    margin: 0;
    max-width: 52rem;
  }
</style>
