---
import Base from '../layouts/Base.astro';
import EntitlementsPage from '../components/EntitlementsPage.vue';
---

<Base title="Entitlements">
  <div class="af-page-head">
    <div>
      <h1>Entitlements</h1>
      <p>What each group on this platform grants, and which ones you're currently in.</p>
    </div>
  </div>

  <EntitlementsPage client:load />
</Base>

<style>
  .af-page-head {
    margin-bottom: var(--space-24);
  }

  .af-page-head h1 {
    font-size: var(--text-24);
    line-height: 1.3;
  }
</style>
