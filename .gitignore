# setuptools_scm / hatch-vcs
broker/src/*/_version.py

# Pixi / Python
.pixi/
__pycache__/
*.py[cod]
*.pyo
.mypy_cache/
.ruff_cache/
dist/
*.egg-info/
*.egg
.eggs/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.so
build/

# Zensical build output
site/

# Virtual environments
.venv/
venv/
env/

# Node / Portal
node_modules/
portal/dist/
portal/.astro/
portal/node_modules/
.npm/
# Rendered from nginx.conf.template by scripts/sync-csp-hashes.mjs at build
# time (see `npm run build` in portal/package.json) — not checked in because
# its CSP hashes are only valid for the build that produced them.
portal/nginx.conf.generated

# Environment / secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Local-only operator helper scripts (e.g. mint-token.py) — not versioned for now.
# `scripts/*` (not `scripts/`) so the exception below can re-include one file --
# git cannot un-ignore a path whose parent directory is itself excluded.
scripts/*
# Exception: verify-mcp-flow.py is a real PR deliverable (issue #58 Part D) --
# a runnable /mcp end-to-end check meant for any operator to check out and
# run, not a personal local-only helper like the rest of scripts/.
!scripts/verify-mcp-flow.py

# Helm — packed charts and downloaded dependencies
charts/*/charts/
*.tgz
# Note: *-sealed.yaml files are Sealed Secrets and ARE safe to commit.
# Do NOT add them here.

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
